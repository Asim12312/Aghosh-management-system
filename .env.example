# PostgreSQL connection string. Leave unset to use the embedded PGlite database in ./.data (development only).
# DATABASE_URL=postgres://aghosh:change-me@localhost:5432/aghosh_mis
# PGLITE_DATA_DIR=./.data/pglite

# Facility timezone used for "today", alerts and timestamps.
APP_TIMEZONE=Asia/Karachi
NEXT_PUBLIC_APP_TIMEZONE=Asia/Karachi

# Shared secret for GET /api/cron/daily-alerts (send as "Authorization: Bearer <secret>").
CRON_SECRET=change-me
